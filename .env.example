# ---------------------------------------------------------------------------
# Chakravyuh - example configuration. Copy to .env and fill in.
# Every value below is a placeholder. Never commit a real key.
# ---------------------------------------------------------------------------

# Required. The API refuses to start without it, so an unset key can never
# leave the endpoints open. Any string of 8+ characters.
API_SECRET_KEY=choose-a-long-random-string

# ---------------------------------------------------------------------------
# LLM - one OpenAI-compatible endpoint. No key pools, no rotation.
# ---------------------------------------------------------------------------
# Required for full behaviour. Without it the Guardian still detects using its
# deterministic rules and the Decoy falls back to scripted replies.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# MongoDB - optional.
# Leave empty to run an in-process MongoDB for the session (nothing to install,
# nothing persisted). Set it to use your own instance.
# ---------------------------------------------------------------------------
MONGO_URI=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# Cosmetic pause before a decoy reply, in milliseconds. Keep at 0 unless a live
# demo needs the typing to look slower. It is reported separately and is never
# counted toward any engagement metric.
REPLY_DELAY_MS=0

# ---------------------------------------------------------------------------
# Guardian thresholds, on the 0-100 rule score.
# A hand-off to the decoy also requires at least one hard signal; that gate is
# not configurable, because baiting a real caller is the one outcome this
# system must never produce.
# ---------------------------------------------------------------------------
GUARDIAN_DECOY_THRESHOLD=60
GUARDIAN_SUSPICIOUS_THRESHOLD=30
GUARDIAN_RELEASE_THRESHOLD=30

# Set to 1 to remove the decoy's typing delay for a live demo. Off by default:
# an elderly person typing with one finger does not answer instantly, and a
# scammer notices that.
DEMO_MODE=0

# How long a session is kept before it is deleted, in days. A transcript of a
# scam call holds what an elderly person was told, when and by whom, so keeping
# it forever is a liability rather than an asset. A sweep runs at boot and every
# six hours.
#
# 0 disables the sweep and keeps sessions indefinitely. That is the only setting
# under which nothing is ever deleted, and the server logs a warning about it on
# every boot. See ETHICS.md.
SESSION_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Offline demo.
# ---------------------------------------------------------------------------
# Set to 1 to answer every model call from a hand-written script, with no
# network at all. For a demo on bad Wi-Fi: the system already works without a
# model (the Guardian falls back to its rules, the Decoy to scripted lines),
# but those forty-odd sentences start repeating inside six turns.
#
# It is NOT a model and never pretends to be one. While it is on, /health
# reports llm.scripted=true, /demo-config reports fakeLlm=true, and the console
# shows a SCRIPTED REPLIES - FAKE_LLM badge. A scripted reply shown as a model
# reply would be a worse failure than an offline demo.
#
# See docs/DEMO.md.
FAKE_LLM=0
